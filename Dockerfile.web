FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

ARG DB_PROFILE=postgres

COPY . .

RUN HUSKY=0 pnpm install --frozen-lockfile \
  && pnpm db:use ${DB_PROFILE} \
  && pnpm db:generate \
  && pnpm --filter @inboxctrl/web build

EXPOSE 3000

CMD ["pnpm", "--filter", "@inboxctrl/web", "exec", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
